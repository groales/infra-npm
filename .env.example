TZ=Europe/Madrid
PUID=1000
PGID=1000

# Ruta de proyectos en el host (la que quieres que Arcane gestione)
PROJECTS_DIRECTORY=/Users/groales/Developer

# Nginx Proxy Manager
# TZ ya se usa en el stack (no requiere token)

# Arcane
APP_URL=https://arcane.example.com
# Genera una clave segura (ejemplo): openssl rand -hex 32
ENCRYPTION_KEY=
# Genera un secreto JWT seguro (ejemplo): openssl rand -hex 32
JWT_SECRET=

# Tailscale
TS_AUTHKEY= # Clave de autenticación de Tailscale
TS_HOSTNAME= mydockerhost # Cambia por el nombre de host que quieras para Tailscale
TS_ROUTES=192.168.X.X/24 # Cambia por la subred de tu red local
